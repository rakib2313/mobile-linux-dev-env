# Copy to .env and edit:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Only MLD_* keys are read, and the file is parsed - never executed.
# Use KEY=value on its own line (no inline comments).

# Performance profile: auto, low, mid or high
MLD_PROFILE=auto

# Linux username inside the Debian guest
MLD_USER=dev

# Non-interactive installs only. Leave EMPTY to be prompted securely at install time.
# The value is written to a temporary 0600 file, consumed once, then deleted.
MLD_VNC_PASSWORD=

# Optional AI assistant defaults (or run: ai-assistant configure). Leave the key empty here;
# the configure command stores it in ~/.config/mld/ai.env with mode 600.
MLD_AI_PROVIDER=anthropic
MLD_AI_MODEL=
MLD_AI_BASE_URL=
MLD_AI_API_KEY=
